+    val results = filterEditingTools(modules, query, enabledOnly)
+    ModalBottomSheet(onDismissRequest = onDismiss, sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true)) {
+        Column(Modifier.fillMaxWidth().padding(horizontal = 16.dp).testTag("editor_tool_catalog")) {
+            Text(stringResource(R.string.studio_tool_catalog), style = MaterialTheme.typography.titleLarge)
+            Text(stringResource(R.string.studio_tool_catalog_hint), style = MaterialTheme.typography.bodySmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant)
+            Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                OutlinedTextField(query, { query = it }, singleLine = true,
+                    label = { Text(stringResource(R.string.tools_search)) },
+                    modifier = Modifier.weight(1f).testTag("editor_catalog_search"))
+                FilterChip(enabledOnly, { enabledOnly = !enabledOnly }, label = { Text(stringResource(R.string.tools_enabled)) })
+            }
+            Spacer(Modifier.height(8.dp))
+            LazyColumn(Modifier.fillMaxWidth().heightIn(max = 440.dp)) {
+                if(results.isEmpty()) item { Text(stringResource(R.string.tools_no_matches), Modifier.padding(16.dp)) }
+                items(results, key = { it.operation }) { module ->
+                    Surface(onClick = { onSelect(module.operation) }, enabled = !busy,
+                        shape = MaterialTheme.shapes.medium,
+                        color = if(module.operation == selected) MaterialTheme.colorScheme.secondaryContainer
+                            else MaterialTheme.colorScheme.surface,
+                        modifier = Modifier.fillMaxWidth().testTag("editor_catalog_${module.operation}")) {
+                        Row(Modifier.padding(horizontal = 12.dp, vertical = 12.dp).heightIn(min = 36.dp),
+                            verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+                            Box(Modifier.size(8.dp).clip(CircleShape).background(if(module.enabled)
+                                MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.outlineVariant))
+                            Column(Modifier.weight(1f)) {
+                                Text(module.name, fontWeight = if(module.operation == selected) FontWeight.SemiBold else FontWeight.Normal)
+                                Text(module.operation, style = MaterialTheme.typography.labelSmall,
+                                    color = MaterialTheme.colorScheme.onSurfaceVariant)
+                            }
+                            Text(stringResource(if(module.enabled) R.string.workspace_enabled else R.string.workspace_disabled),
+                                style = MaterialTheme.typography.labelSmall)
+                        }
+                    }
+                }
+                item { Spacer(Modifier.height(24.dp)) }
+            }
+        }
+    }
