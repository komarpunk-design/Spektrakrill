+@Composable
+internal fun WorkspaceToolCatalog(modules: List<EditorModule>, selected: String?, busy: Boolean,
+                                  onDismiss: () -> Unit, onSelect: (String) -> Unit) {
+    var query by rememberSaveable { mutableStateOf("") }
