+/** Zoom changes presentation only. Coordinate-sensitive native tools always see the untransformed photo. */
+@Composable
+internal fun WorkspacePhotoViewport(sessionId: Long, imageWidth: Int, imageHeight: Int, gesturesEnabled: Boolean,
+                                    content: @Composable () -> Unit) {
+    var scale by rememberSaveable(sessionId) { mutableFloatStateOf(1f) }
+    var panX by rememberSaveable(sessionId) { mutableFloatStateOf(0f) }
+    var panY by rememberSaveable(sessionId) { mutableFloatStateOf(0f) }
+    LaunchedEffect(gesturesEnabled, imageWidth, imageHeight) {
+        scale = 1f; panX = 0f; panY = 0f
+    }
+    BoxWithConstraints(Modifier.fillMaxSize().clipToBounds().testTag("editor_photo_viewport")) {
+        val density = LocalDensity.current
+        val width = with(density) { maxWidth.toPx() }
+        val height = with(density) { maxHeight.toPx() }
+        val pan = boundedPreviewPan(Offset(panX, panY), scale, width, height, imageWidth, imageHeight)
+        val gestureModifier = if(gesturesEnabled) Modifier
+            .pointerInput(sessionId, width, height, imageWidth, imageHeight) {
+                detectTransformGestures { centroid, movement, zoom, _ ->
+                    val nextScale = (scale * zoom).coerceIn(1f, 8f)
+                    val centre = Offset(width / 2f, height / 2f)
+                    val proposed = (Offset(panX, panY) - (centroid - centre)) * (nextScale / scale) +
+                        (centroid - centre) + movement
+                    val bounded = boundedPreviewPan(proposed, nextScale, width, height, imageWidth, imageHeight)
+                    scale = nextScale; panX = bounded.x; panY = bounded.y
+                }
+            }.pointerInput(sessionId, width, height) {
+                detectTapGestures(onDoubleTap = {
+                    scale = if(scale > 1f) 1f else 2f
+                    panX = 0f; panY = 0f
+                })
+            } else Modifier
+        Box(Modifier.fillMaxSize().then(gestureModifier)) {
+            Box(Modifier.fillMaxSize().graphicsLayer {
+                scaleX = scale; scaleY = scale; translationX = pan.x; translationY = pan.y
+            }) { content() }
+        }
+        if(scale > 1f) FilledTonalButton(onClick = { scale = 1f; panX = 0f; panY = 0f },
+            modifier = Modifier.align(Alignment.BottomEnd).padding(8.dp).testTag("editor_zoom_reset")) {
+            Text(stringResource(R.string.studio_fit_photo))
+        }
+    }
+}
