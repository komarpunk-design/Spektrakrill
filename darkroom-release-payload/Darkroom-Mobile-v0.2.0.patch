+@Composable
+internal fun InspectorResizeHandle(wide: Boolean, fraction: Float, extent: Float, range: ClosedFloatingPointRange<Float> = .30f.. .72f,
+                                  onFraction: (Float) -> Unit) {
+    val description = stringResource(R.string.studio_resize)
+    val drag = rememberDraggableState { delta ->
+        if(extent > 0f) onFraction(inspectorPreviewFraction(fraction + delta / extent).coerceIn(range))
+    }
+    Box((if(wide) Modifier.width(24.dp).fillMaxHeight() else Modifier.height(24.dp).fillMaxWidth())
+        .background(LocalEditorChromeColors.current.panel)
+        .testTag("editor_resize_handle")
+        .semantics {
+            contentDescription = description
+            progressBarRangeInfo = ProgressBarRangeInfo(fraction, range.start..range.endInclusive)
+            setProgress { requested -> onFraction(inspectorPreviewFraction(requested).coerceIn(range)); true }
+            onClick { onFraction(.55f.coerceIn(range)); true }
+        }
+        .draggable(drag, if(wide) Orientation.Horizontal else Orientation.Vertical),
+        contentAlignment = Alignment.Center) {
+        Box((if(wide) Modifier.width(4.dp).height(36.dp) else Modifier.width(36.dp).height(4.dp))
+            .clip(CircleShape).background(MaterialTheme.colorScheme.outlineVariant))
+    }
+}
