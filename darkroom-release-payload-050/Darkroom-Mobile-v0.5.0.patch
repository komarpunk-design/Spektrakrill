+                }
+            } catch(_: CancellationException) {
+            } catch(failure: Exception) {
+                failureNotice = errorMessage(failure)
+            } finally {
+                withContext(NonCancellable + Dispatchers.IO) {
+                    runCatching { batchStore.recoverInterrupted() }
+                    mutableBatch.value = batchStore.list().map { job ->
+                        if(job.status == org.example.darktableandroid.storage.BatchStatus.RUNNING)
+                            job.copy(status = org.example.darktableandroid.storage.BatchStatus.INTERRUPTED, error = failureNotice)
+                        else job
