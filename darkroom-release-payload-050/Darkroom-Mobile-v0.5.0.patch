+@Composable
+private fun PhotoThumbnail(project: PhotoProject, modifier: Modifier) {
+    val context = LocalContext.current
+    val thumbnail by produceState<Pair<android.graphics.Bitmap?, Boolean>>(null to false, project.id, project.updated) {
+        value = withContext(Dispatchers.IO) {
+            val cached = android.graphics.BitmapFactory.decodeFile(project.thumbnail.path)
+            if(cached != null) cached to true else {
+                val bounds = android.graphics.BitmapFactory.Options().apply { inJustDecodeBounds = true }
+                android.graphics.BitmapFactory.decodeFile(project.source.path, bounds)
+                val direct = if(bounds.outWidth > 0 && bounds.outHeight > 0) {
+                    val options = android.graphics.BitmapFactory.Options().apply {
+                        inSampleSize = (maxOf(bounds.outWidth, bounds.outHeight) / 320).coerceAtLeast(1)
+                    }
+                    android.graphics.BitmapFactory.decodeFile(project.source.path, options)
+                } else null
+                val provided = direct ?: runCatching {
+                    val uri = android.net.Uri.parse(project.sourceUri)
+                    if(android.os.Build.VERSION.SDK_INT >= 29)
+                        context.contentResolver.loadThumbnail(uri, android.util.Size(320, 240), null)
+                    else {
+                        @Suppress("DEPRECATION")
+                        android.provider.DocumentsContract.getDocumentThumbnail(context.contentResolver, uri, android.graphics.Point(320, 240), null)
+                    }
+                }.getOrNull()
+                provided to false
+            }
+        }
+    }
+    Box(modifier.background(LocalEditorChromeColors.current.preview), contentAlignment = Alignment.Center) {
+        thumbnail.first?.let {
+            Image(it.asImageBitmap(), null, Modifier.fillMaxSize(), contentScale = ContentScale.Fit)
+            if(!thumbnail.second) Text(stringResource(R.string.desktop_source_preview),
+                Modifier.align(Alignment.BottomStart).background(MaterialTheme.colorScheme.surface.copy(alpha = .85f)).padding(3.dp),
+                style = MaterialTheme.typography.labelSmall)
+        } ?: Icon(painterResource(R.drawable.workspace_ic_open), null, tint = MaterialTheme.colorScheme.onSurfaceVariant)
+    }
+}
