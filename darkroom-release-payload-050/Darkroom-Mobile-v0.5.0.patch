+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+internal fun CatalogMarksDialog(initial: CatalogMarks, onDismiss: () -> Unit, onApply: (CatalogMarks) -> Unit) {
+    var rating by rememberSaveable { mutableIntStateOf(initial.rating) }
+    var colors by rememberSaveable { mutableIntStateOf(initial.colors) }
+    var tags by rememberSaveable { mutableStateOf(initial.tags.joinToString("\n")) }
+    val parsed = remember(rating, colors, tags) { runCatching {
+        CatalogMarks(rating, colors, if(tags == initial.tags.joinToString("\n")) initial.tags
+            else tags.lines().map(String::trim).filter(String::isNotEmpty).distinct())
+    } }
+    ModalBottomSheet(onDismissRequest = onDismiss,
+        sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true)) {
+        Column(Modifier.fillMaxWidth().padding(horizontal = 16.dp)) {
+            Text(stringResource(R.string.catalog_marks), style = MaterialTheme.typography.titleLarge)
+            Column(Modifier.fillMaxWidth().weight(1f, fill = false).heightIn(max = 420.dp).verticalScroll(rememberScrollState())) {
+                Text(stringResource(R.string.catalog_marks_hint))
+                Row(Modifier.horizontalScroll(rememberScrollState()), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    for(value in 0..5) FilterChip(rating == value, { rating = value }, label = { Text("$value★") },
+                        modifier = Modifier.testTag("mark_rating_$value"))
+                    FilterChip(rating == -1, { rating = -1 }, label = { Text(stringResource(R.string.catalog_rejected)) })
+                }
+                listOf(R.string.catalog_red, R.string.catalog_yellow, R.string.catalog_green,
+                    R.string.catalog_blue, R.string.catalog_purple).forEachIndexed { i, label ->
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        Checkbox(colors and (1 shl i) != 0, { colors = colors xor (1 shl i) })
+                        Text(stringResource(label))
+                    }
+                }
+                OutlinedTextField(tags, { tags = it }, label = { Text(stringResource(R.string.catalog_tags)) },
+                    modifier = Modifier.fillMaxWidth().testTag("catalog_tags_input"), isError = parsed.isFailure)
+                if(parsed.isFailure) Text(stringResource(R.string.catalog_tags_invalid), color = MaterialTheme.colorScheme.error)
+            }
+            Row {
+                Button({ onApply(parsed.getOrThrow()) }, enabled = parsed.isSuccess) { Text(stringResource(R.string.apply)) }
+                TextButton(onDismiss) { Text(stringResource(R.string.cancel)) }
+            }
+        }
+    }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+internal fun BatchExportPanel(jobs: List<BatchExport>, busy: Boolean, onDismiss: () -> Unit,
+    onStart: () -> Unit, onStop: () -> Unit, onRetry: (String) -> Unit, canStart: Boolean = true) {
+    ModalBottomSheet(onDismissRequest = onDismiss,
+        sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true)) {
+        Column(Modifier.fillMaxWidth().fillMaxHeight(0.94f).padding(horizontal = 16.dp).testTag("batch_export_panel")) {
+            Text(stringResource(R.string.catalog_queue), style = MaterialTheme.typography.titleLarge)
+            Text(stringResource(R.string.catalog_queue_hint), style = MaterialTheme.typography.bodySmall)
+            if(!canStart) Text(stringResource(R.string.catalog_open_for_export), style = MaterialTheme.typography.bodySmall)
+            LazyColumn(Modifier.fillMaxWidth().weight(1f)) {
+                if(jobs.isEmpty()) item { Text(stringResource(R.string.catalog_queue_empty), Modifier.padding(16.dp)) }
+                items(jobs, key = { it.id }) { job ->
+                    Column(Modifier.fillMaxWidth().padding(vertical = 8.dp).testTag("batch_${job.id}")) {
+                        Text(job.name, style = MaterialTheme.typography.titleSmall)
+                        Text(stringResource(when(job.status) {
+                            BatchStatus.PENDING -> R.string.catalog_pending
+                            BatchStatus.RUNNING -> R.string.catalog_running
+                            BatchStatus.DONE -> R.string.catalog_completed
+                            BatchStatus.FAILED -> R.string.catalog_failed
+                            BatchStatus.INTERRUPTED -> R.string.catalog_interrupted
+                            BatchStatus.CANCELLED -> R.string.catalog_cancelled
+                        }) + " · " + job.format)
+                        if(job.status == BatchStatus.RUNNING) LinearProgressIndicator(Modifier.fillMaxWidth())
+                        job.error?.let { Text(it, style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.error) }
+                        if(job.status in setOf(BatchStatus.FAILED, BatchStatus.INTERRUPTED, BatchStatus.CANCELLED))
+                            TextButton({ onRetry(job.id) }, enabled = !busy) { Text(stringResource(R.string.catalog_retry)) }
+                    }
+                }
+            }
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                if(busy) OutlinedButton(onStop) { Text(stringResource(R.string.catalog_stop)) }
+                else Button(onStart, enabled = canStart && jobs.any { it.status == BatchStatus.PENDING }) { Text(stringResource(R.string.catalog_start)) }
+                Spacer(Modifier.weight(1f))
+                TextButton(onDismiss) { Text(stringResource(R.string.done)) }
+            }
+        }
+    }
+}
