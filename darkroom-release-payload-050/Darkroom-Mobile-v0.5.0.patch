+    private fun exportBatchItem(job: BatchExport, cancellation: BatchCancellation): String {
+        val project = projectStore.read(job.projectId)
+        val scratch = File(getApplication<Application>().cacheDir, "batch-work/${UUID.randomUUID()}")
+        check(scratch.mkdirs())
+        var handle = 0L
+        try {
+            check(!cancellation.cancelled) { "Export stopped" }
+            val source = scratch.resolve(project.source.name)
+            project.source.inputStream().use { input -> source.outputStream().use { output ->
+                val buffer = ByteArray(128 * 1024)
+                while(true) {
+                    check(!cancellation.cancelled) { "Export stopped" }
+                    val count = input.read(buffer); if(count < 0) break
+                    output.write(buffer, 0, count)
+                }
+            } }
+            batchStore.history(job)?.copyTo(File(source.path + ".xmp"))
+            handle = NativeCore.open(source.path)
+            cancellation.attach(handle)
+            NativeCatalog.restore(source.path, File(source.path + ".xmp"))
+            val installed = parseExportFormats(NativeCore.listExportFormats(handle)).single { it.id == job.format }
+            val output = scratch.resolve("output.${job.extension}")
+            if(job.extended) {
+                check(installed.options?.isValid(job.settings) == true) { "Queued encoder settings are unavailable" }
+                NativeCore.exportWithSettings(handle, output.path, job.format, job.settings.toNativeArray())
+            } else NativeCore.exportImage(handle, output.path, job.format, job.settings.quality)
+            check(!cancellation.cancelled && output.length() > 0) { "Export stopped or produced an empty file" }
+            val resolver = getApplication<Application>().contentResolver
+            val tree = Uri.parse(job.tree)
+            val parent = DocumentsContract.buildDocumentUriUsingTree(tree, DocumentsContract.getTreeDocumentId(tree))
+            val stem = job.name.substringBeforeLast('.').replace(Regex("[^\\p{L}\\p{N}_-]"), "_").take(64).ifBlank { "photo" }
+            val target = checkNotNull(DocumentsContract.createDocument(resolver, parent, job.mime,
+                "$stem-${UUID.randomUUID()}.${job.extension}")) { "Cannot create the exported document" }
+            var committed = false
+            try {
+                resolver.openOutputStream(target, "wt").use { destination ->
+                    checkNotNull(destination)
+                    output.inputStream().use { input ->
+                        val buffer = ByteArray(128 * 1024)
+                        while(true) {
+                            check(!cancellation.cancelled) { "Export stopped" }
+                            val count = input.read(buffer); if(count < 0) break
+                            destination.write(buffer, 0, count)
+                        }
+                    }
+                }
+                fun digest(input: java.io.InputStream): ByteArray = input.use {
+                    val sha = java.security.MessageDigest.getInstance("SHA-256")
+                    val buffer = ByteArray(128 * 1024)
+                    while(true) {
+                        check(!cancellation.cancelled) { "Export stopped" }
+                        val count = it.read(buffer); if(count < 0) break
+                        sha.update(buffer, 0, count)
+                    }
+                    sha.digest()
+                }
+                val verified = digest(checkNotNull(resolver.openInputStream(target)))
+                check(verified.contentEquals(digest(output.inputStream()))) { "The document provider saved an incomplete file" }
+                committed = true
+                return target.toString()
+            } finally { if(!committed) runCatching { DocumentsContract.deleteDocument(resolver, target) } }
+        } finally {
+            cancellation.detach()
+            if(handle != 0L) NativeCore.close(handle)
+            scratch.deleteRecursively()
+        }
+    }
