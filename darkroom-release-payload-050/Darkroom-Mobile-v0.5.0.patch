+    internal fun applyModulePreset(identifier: String, id: String) {
+        val preset = mutablePresets.value.singleOrNull { it.id == id } ?: return
+        applyInstanceOperation(identifier) { active, before, folder ->
+            val normalized = NativeStyleSelection.normalize(active.project.source.path, folder)
+            val history = processingHistory(normalized)
+            val target = history.latest.singleOrNull { it.identifier == identifier }
+            check(history.latest.count { it.operation == preset.operation && it.name == target?.name.orEmpty() } <= 1) {
+                "Rename instances with identical names before applying a preset"
+            }
+            val (name, bytes) = modulePresetStyle(preset, target, identifier)
+            val style = folder.resolve("preset.dtstyle").apply { writeBytes(bytes) }
+            val output = folder.resolve("next.xmp")
+            NativeDesktop.writeStyledSidecar(active.project.source.path, style.path, name, output.path, false)
+            val next = validatedDarktableXmp(output.readBytes())
+            assertOnlyInstanceChanged(normalized, next, identifier)
+            val applied = processingHistory(next).latest.single { it.identifier == identifier }
+            check(applied.enabled == preset.enabled) { "The native preset enabled state was not applied" }
+            if(preset.params.isNotEmpty() && preset.version == applied.version)
+                check(decodedParameters(preset.params).contentEquals(decodedParameters(applied.params))) { "The native preset parameters were not applied" }
+            else if(preset.version != applied.version)
+                check(!next.contentEquals(before) && (target == null || !target.sameProcessing(applied))) { "The native preset version could not be migrated" }
+            next
+        }
+    }
