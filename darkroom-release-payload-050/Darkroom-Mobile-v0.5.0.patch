@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.example.darktableandroid.storage
+
+import java.io.File
+import java.io.StringReader
+import java.nio.charset.CodingErrorAction
+import java.nio.charset.StandardCharsets
+import java.util.UUID
+import javax.xml.parsers.DocumentBuilderFactory
+import org.json.JSONObject
+import org.xml.sax.InputSource
+import org.xml.sax.SAXException
+import org.xml.sax.helpers.DefaultHandler
+
+internal data class PhotoProject(val id: String, val name: String, val sourceUri: String,
+    val updated: Long, val selectedModule: String?, val directory: File, val source: File) {
+    val sidecar get() = File(source.absolutePath + ".xmp")
+    val thumbnail get() = directory.resolve("thumbnail.jpg")
+    val assets get() = directory.resolve("assets")
+}
+
+internal data class ProjectSnapshot(val id: String, val name: String, val created: Long, val sidecar: File)
+
+/** Originals, XMP and imported assets live in filesDir, never an evictable cache.
+ * Each project owns an independent source path; editing one copy cannot update another. */
+internal class PhotoProjects(private val root: File) {
+    fun list(): List<PhotoProject> = root.listFiles().orEmpty().mapNotNull { directory ->
+        runCatching { read(directory.name) }.getOrNull()
+    }.sortedByDescending { it.updated }
+
+    fun read(id: String): PhotoProject {
+        val directory = directory(id)
+        val json = JSONObject(directory.resolve("project.json").readText())
+        require(json.getInt("version") == 1 && json.getString("id") == id)
+        val sourceName = json.getString("source")
+        require(sourceName.matches(Regex("source\\.[a-z0-9]{1,10}")))
+        val source = directory.resolve(sourceName)
+        check(source.isFile && source.length() > 0) { "The project's original is missing" }
+        return PhotoProject(id, json.getString("name"), json.getString("uri"), json.getLong("updated"),
+            json.optString("selected").takeIf { it.isNotBlank() }, directory, source)
+    }
+
+    fun create(original: File, sourceUri: String, name: String): PhotoProject {
+        val id = UUID.randomUUID().toString()
+        val directory = directory(id)
+        check(directory.mkdirs()) { "Unable to create the photo project" }
+        try {
+            val source = directory.resolve("source.${safeExtension(original.name)}")
+            original.inputStream().use { input -> source.outputStream().buffered().use { input.copyTo(it) } }
+            check(source.length() == original.length() && source.length() > 0) { "The original was not copied completely" }
+            val project = PhotoProject(id, name.take(200).ifBlank { original.name }, sourceUri,
+                System.currentTimeMillis(), null, directory, source)
+            update(project, null)
+            return project
+        } catch(failure: Throwable) {
+            directory.deleteRecursively()
+            throw failure
+        }
+    }
+
+    fun update(project: PhotoProject, selected: String?): PhotoProject {
+        val next = project.copy(updated = System.currentTimeMillis(), selectedModule = selected)
+        val json = JSONObject().put("version", 1).put("id", next.id).put("name", next.name)
+            .put("uri", next.sourceUri).put("source", next.source.name).put("updated", next.updated)
+            .put("selected", selected ?: "")
+        atomicWrite(next.directory.resolve("project.json"), json.toString().toByteArray(Charsets.UTF_8))
+        return next
+    }
+
+    fun snapshot(project: PhotoProject, name: String): ProjectSnapshot {
+        check(project.sidecar.isFile) { "Save the current processing before making a snapshot" }
+        val id = UUID.randomUUID().toString()
+        val directory = project.directory.resolve("snapshots").apply { check(isDirectory || mkdirs()) }
+        val created = System.currentTimeMillis()
+        val file = directory.resolve("$id.xmp")
+        atomicWrite(file, project.sidecar.readBytes())
+        try {
+            atomicWrite(directory.resolve("$id.json"), JSONObject().put("name", name.take(200))
+                .put("created", created).toString().toByteArray())
+        } catch(failure: Throwable) { file.delete(); throw failure }
+        return ProjectSnapshot(id, name.take(200), created, file)
+    }
+
+    fun snapshots(project: PhotoProject): List<ProjectSnapshot> =
+        project.directory.resolve("snapshots").listFiles().orEmpty().filter { it.extension == "json" }.mapNotNull { file ->
+            runCatching {
+                UUID.fromString(file.nameWithoutExtension)
+                val json = JSONObject(file.readText())
+                val xmp = File(file.path.removeSuffix("json") + "xmp")
+                check(xmp.isFile && xmp.length() > 0)
+                ProjectSnapshot(file.nameWithoutExtension, json.getString("name"), json.getLong("created"), xmp)
+            }.getOrNull()
+        }.sortedByDescending { it.created }
+
+    private fun directory(id: String): File {
+        require(UUID.fromString(id).toString() == id) { "Invalid photo project" }
+        return root.resolve(id)
+    }
+}
+
+internal fun atomicWrite(target: File, bytes: ByteArray) {
+    check(target.parentFile!!.isDirectory || target.parentFile!!.mkdirs())
+    val incoming = File.createTempFile(".saving-", ".part", target.parentFile)
+    try {
+        incoming.outputStream().use { output -> output.write(bytes); output.fd.sync() }
+        check(incoming.renameTo(target)) { "Unable to commit the saved file" }
+    } finally { incoming.delete() }
+}
+
+/** Accept darktable XMP, not arbitrary XML with external entities. */
+internal fun checkedProcessingXml(bytes: ByteArray): org.w3c.dom.Document {
+    require(bytes.isNotEmpty() && bytes.size <= 16 * 1024 * 1024) { "Choose a darktable XMP up to 16 MiB" }
+    val text = StandardCharsets.UTF_8.newDecoder().onMalformedInput(CodingErrorAction.REPORT)
+        .onUnmappableCharacter(CodingErrorAction.REPORT).decode(java.nio.ByteBuffer.wrap(bytes)).toString()
+    require('\u0000' !in text && !Regex("<!\\s*(DOCTYPE|ENTITY)", RegexOption.IGNORE_CASE).containsMatchIn(text)) {
+        "XMP with DTD or external entities is not supported"
+    }
+    val builder = DocumentBuilderFactory.newInstance().apply {
+        isNamespaceAware = true
+        isExpandEntityReferences = false
+    }.newDocumentBuilder()
+    builder.setEntityResolver { _, _ -> throw SAXException("External entities are forbidden") }
+    builder.setErrorHandler(object : DefaultHandler() {
+        override fun error(e: org.xml.sax.SAXParseException) { throw e }
+        override fun fatalError(e: org.xml.sax.SAXParseException) { throw e }
+    })
+    return builder.parse(InputSource(StringReader(text)))
+}
+
+internal fun validatedDarktableXmp(bytes: ByteArray): ByteArray {
+    val document = checkedProcessingXml(bytes)
+    require(document.getElementsByTagNameNS("http://darktable.sf.net/", "history").length > 0) {
+        "The file contains no darktable processing history"
+    }
+    return bytes.copyOf()
+}
diff --git a/android/app/src/main/kotlin/org/example/darktableandroid/storage/PhotoStyles.kt b/android/app/src/main/kotlin/org/example/darktableandroid/storage/PhotoStyles.kt
new file mode 100644
index 0000000000000000000000000000000000000000..4d19cfe2034c5f254d12a7362f0ca27a4ec4e3dd
--- /dev/null
+++ b/android/app/src/main/kotlin/org/example/darktableandroid/storage/PhotoStyles.kt
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.example.darktableandroid.storage
+
+import java.io.File
+import java.security.MessageDigest
+
+internal data class PhotoStyle(val id: String, val name: String, val description: String,
+    val operations: Set<String>, val file: File, val origin: StyleOrigin = StyleOrigin.PERSONAL,
+    val requiresDevelopmentEngine: Boolean = false)
+
+internal enum class StyleOrigin { PERSONAL, EXAMPLE, CAMERA }
+
+internal class PhotoStyles(private val root: File, private val bundled: File? = null) {
+    private val bundledStyles by lazy {
+        bundled?.walkTopDown()?.filter { it.isFile && it.extension == "dtstyle" }?.mapNotNull { file ->
+            runCatching {
+                val origin = if(file.name.startsWith("darktable_")) StyleOrigin.CAMERA else StyleOrigin.EXAMPLE
+                readStyle(file.readBytes(), file).let { it.copy(id = "bundled-${it.id}", origin = origin) }
+            }.getOrNull()
+        }?.toList().orEmpty()
+    }
+
+    fun list(): List<PhotoStyle> = (root.listFiles().orEmpty().filter { it.extension == "dtstyle" }
+        .mapNotNull { file -> runCatching { readStyle(file.readBytes(), file) }.getOrNull() }
+        + bundledStyles).sortedWith(compareBy(String.CASE_INSENSITIVE_ORDER) { it.name })
+
+    fun retain(bytes: ByteArray): PhotoStyle {
+        val id = MessageDigest.getInstance("SHA-256").digest(bytes).joinToString("") { "%02x".format(it) }
+        val file = root.resolve("$id.dtstyle")
+        val style = readStyle(bytes, file)
+        if(!file.exists()) atomicWrite(file, bytes)
+        return style
+    }
+
+    private fun readStyle(bytes: ByteArray, file: File): PhotoStyle {
+        val document = checkedProcessingXml(bytes)
+        require(document.documentElement.tagName == "darktable_style") { "Choose an original darktable .dtstyle file" }
+        val info = document.getElementsByTagName("info").item(0) as? org.w3c.dom.Element
+        val name = info?.getElementsByTagName("name")?.item(0)?.textContent?.trim().orEmpty()
+        require(name.isNotEmpty() && name.toByteArray(Charsets.UTF_8).size <= 4096) { "The style has no usable name" }
+        val plugins = document.getElementsByTagName("plugin")
+        require(plugins.length in 1..2048) { "The style contains no processing tools" }
+        val operations = (0 until plugins.length).map { index ->
+            val plugin = plugins.item(index) as org.w3c.dom.Element
+            val operation = plugin.getElementsByTagName("operation").item(0)?.textContent.orEmpty()
+            require(operation.matches(Regex("[a-zA-Z0-9_]{1,64}"))) { "The style contains an invalid tool identity" }
+            operation
+        }.toSet()
+        val digest = MessageDigest.getInstance("SHA-256").digest(bytes).joinToString("") { "%02x".format(it) }
+        val blendVersions = document.getElementsByTagName("blendop_version")
+        val modernBlend = (0 until blendVersions.length).any {
+            (blendVersions.item(it).textContent.trim().toIntOrNull() ?: 0) >= 15
+        }
+        return PhotoStyle(digest, name,
+            info?.getElementsByTagName("description")?.item(0)?.textContent.orEmpty(), operations, file,
+            requiresDevelopmentEngine = modernBlend)
+    }
+}
diff --git a/android/app/src/main/kotlin/org/example/darktableandroid/storage/ProcessingHistory.kt b/android/app/src/main/kotlin/org/example/darktableandroid/storage/ProcessingHistory.kt
new file mode 100644
index 0000000000000000000000000000000000000000..d7fc76595b231aabeff0cada4f6a87924bc00592
--- /dev/null
+++ b/android/app/src/main/kotlin/org/example/darktableandroid/storage/ProcessingHistory.kt
@@ -0,0 +1,141 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.example.darktableandroid.storage
+
+import java.io.ByteArrayOutputStream
+import java.util.Base64
+import java.util.zip.InflaterInputStream
+import javax.xml.transform.TransformerFactory
+import javax.xml.transform.dom.DOMSource
+import javax.xml.transform.stream.StreamResult
+import org.w3c.dom.Document
+import org.w3c.dom.Element
+
+internal const val DARKTABLE_NS = "http://darktable.sf.net/"
+internal const val RDF_NS = "http://www.w3.org/1999/02/22-rdf-syntax-ns#"
+
+internal data class ProcessingRow(val number: Int, val operation: String, val priority: Int,
+    val name: String, val enabled: Boolean, val version: Int, val params: String,
+    val blend: String, val blendVersion: Int, val named: Boolean) {
+    val identifier get() = if(priority == 0) operation else "$operation@$priority"
+    fun sameProcessing(other: ProcessingRow) = enabled == other.enabled && version == other.version &&
+        decodedParameters(params).contentEquals(decodedParameters(other.params)) &&
+        blendVersion == other.blendVersion && decodedParameters(blend).contentEquals(decodedParameters(other.blend))
+}
+
+internal data class ProcessingHistory(val rows: List<ProcessingRow>, val end: Int) {
+    val active get() = rows.filter { it.number < end }
+    val latest get() = active.groupBy { it.identifier }.map { (_, steps) -> steps.maxBy { it.number } }.sortedBy { it.number }
+}
+
+internal fun processingHistory(bytes: ByteArray): ProcessingHistory {
+    val doc = checkedProcessingXml(bytes)
+    val description = doc.getElementsByTagNameNS(RDF_NS, "Description")
+    var end: Int? = null
+    for(i in 0 until description.length) (description.item(i) as Element).let {
+        if(it.hasAttributeNS(DARKTABLE_NS, "history_end")) end = it.getAttributeNS(DARKTABLE_NS, "history_end").toInt()
+    }
+    val history = doc.getElementsByTagNameNS(DARKTABLE_NS, "history")
+    require(history.length == 1) { "The XMP must contain one native history" }
+    val nodes = (history.item(0) as Element).getElementsByTagNameNS(RDF_NS, "li")
+    val rows = List(nodes.length) { index ->
+        val node = nodes.item(index) as Element
+        fun value(name: String) = node.getAttributeNS(DARKTABLE_NS, name)
+        val operation = value("operation").also { require(it.matches(Regex("[a-z0-9_]{1,64}"))) }
+        ProcessingRow(value("num").toInt(), operation, value("multi_priority").toInt(), value("multi_name"),
+            value("enabled") == "1", value("modversion").toInt(), value("params"), value("blendop_params"),
+            value("blendop_version").toInt(), value("multi_name_hand_edited") == "1").also {
+            require(it.number >= 0 && it.priority >= 0 && it.version > 0)
+        }
+    }
+    require(rows.map { it.number }.distinct().size == rows.size)
+    val activeEnd = checkNotNull(end) { "Missing native history position" }
+    require(activeEnd >= 0 && activeEnd <= (rows.maxOfOrNull { it.number } ?: -1) + 1)
+    return ProcessingHistory(rows, activeEnd)
+}
+
+/** XML encoding only: processing bytes and their migration remain native. */
+internal fun documentBytes(document: Document): ByteArray {
+    val output = ByteArrayOutputStream()
+    TransformerFactory.newInstance().newTransformer().apply {
+        setOutputProperty("encoding", "UTF-8")
+    }.transform(DOMSource(document), StreamResult(output))
+    return output.toByteArray()
+}
+
+internal fun decodedParameters(value: String): ByteArray {
+    if(value.isEmpty()) return byteArrayOf()
+    if(value.startsWith("gz")) {
+        require(value.length >= 4 && value.substring(2, 4).toIntOrNull() in 1..99)
+        val compressed = Base64.getDecoder().decode(value.substring(4))
+        return InflaterInputStream(compressed.inputStream()).use { input ->
+            val output = ByteArrayOutputStream()
+            val buffer = ByteArray(8192)
+            while(true) {
+                val count = input.read(buffer); if(count < 0) break
+                require(output.size().toLong() + count <= 16L * 1024 * 1024) { "Encoded parameters exceed the XMP safety budget" }
+                output.write(buffer, 0, count)
+            }
+            output.toByteArray()
+        }
+    }
+    require(value.length % 2 == 0 && value.length <= 32 * 1024 * 1024)
+    return ByteArray(value.length / 2) { i -> value.substring(i * 2, i * 2 + 2).toInt(16).toByte() }
+}
+
+internal fun assertOnlyInstanceChanged(before: ByteArray, after: ByteArray, identifier: String) {
+    val old = processingHistory(before).latest.associateBy { it.identifier }
+    val next = processingHistory(after).latest.associateBy { it.identifier }
+    check(identifier in next) { "The native engine did not create the selected processing state" }
+    for(key in (old.keys + next.keys) - identifier) {
+        check(old[key] != null && next[key] != null && old.getValue(key).sameProcessing(next.getValue(key))) {
+            "The native operation affected another module instance; processing was not committed"
+        }
+    }
+}
+
+internal fun historyAtPosition(bytes: ByteArray, end: Int): ByteArray {
+    val history = processingHistory(bytes)
+    require(end >= 0 && end <= (history.rows.maxOfOrNull { it.number } ?: -1) + 1)
+    val doc = checkedProcessingXml(bytes)
+    val entries = doc.getElementsByTagNameNS(RDF_NS, "Description")
+    for(i in 0 until entries.length) (entries.item(i) as Element).let {
+        if(it.hasAttributeNS(DARKTABLE_NS, "history_end")) it.setAttributeNS(DARKTABLE_NS, "darktable:history_end", end.toString())
+    }
+    return documentBytes(doc)
+}
+
+internal fun renamedInstance(bytes: ByteArray, identifier: String, name: String): ByteArray {
+    require(name.isNotBlank() && name.toByteArray(Charsets.UTF_8).size <= 127 && '\u0000' !in name)
+    val history = processingHistory(bytes)
+    require(history.latest.any { it.identifier == identifier }) { "Adjust this instance before renaming it" }
+    val doc = checkedProcessingXml(bytes)
+    val entries = (doc.getElementsByTagNameNS(DARKTABLE_NS, "history").item(0) as Element).getElementsByTagNameNS(RDF_NS, "li")
+    for(i in 0 until entries.length) {
+        val row = entries.item(i) as Element
+        val op = row.getAttributeNS(DARKTABLE_NS, "operation")
+        val priority = row.getAttributeNS(DARKTABLE_NS, "multi_priority").toInt()
+        val id = if(priority == 0) op else "$op@$priority"
+        if(id == identifier) {
+            row.setAttributeNS(DARKTABLE_NS, "darktable:multi_name", name)
+            row.setAttributeNS(DARKTABLE_NS, "darktable:multi_name_hand_edited", "1")
+        }
+    }
+    return documentBytes(doc)
+}
+
+/** The native engine allocates the instance and its order; XMP carries opaque settings. */
+internal fun copiedInstance(bytes: ByteArray, sourceId: String, targetId: String): ByteArray {
+    val history = processingHistory(bytes)
+    val source = history.latest.single { it.identifier == sourceId }
+    val target = history.latest.single { it.identifier == targetId }
+    require(source.operation == target.operation && sourceId != targetId)
+    val doc = checkedProcessingXml(bytes)
+    val entries = (doc.getElementsByTagNameNS(DARKTABLE_NS, "history").item(0) as Element).getElementsByTagNameNS(RDF_NS, "li")
+    val row = (0 until entries.length).map { entries.item(it) as Element }
+        .single { it.getAttributeNS(DARKTABLE_NS, "num").toInt() == target.number }
+    for((key, value) in listOf("modversion" to source.version.toString(), "params" to source.params,
+        "enabled" to if(source.enabled) "1" else "0", "blendop_params" to source.blend,
+        "blendop_version" to source.blendVersion.toString(), "multi_name" to target.priority.toString(),
+        "multi_name_hand_edited" to "0")) row.setAttributeNS(DARKTABLE_NS, "darktable:$key", value)
+    return documentBytes(doc)
+}
