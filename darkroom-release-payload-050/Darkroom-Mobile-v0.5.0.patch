+internal fun inspectorPreviewFraction(value: Float): Float =
+    if(value.isFinite()) value.coerceIn(.30f, .72f) else .55f
+
+internal fun boundedPreviewPan(pan: Offset, scale: Float, width: Float, height: Float,
+                               imageWidth: Int, imageHeight: Int): Offset {
+    val fit = fittedPreviewBounds(width, height, imageWidth, imageHeight) ?: return Offset.Zero
+    val limitX = ((fit.width * scale - width) / 2f).coerceAtLeast(0f)
+    val limitY = ((fit.height * scale - height) / 2f).coerceAtLeast(0f)
+    return Offset(pan.x.coerceIn(-limitX, limitX), pan.y.coerceIn(-limitY, limitY))
+}
