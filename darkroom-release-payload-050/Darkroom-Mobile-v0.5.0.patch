diff --git a/android/tools/audit-desktop-surface.py b/android/tools/audit-desktop-surface.py
new file mode 100644
index 0000000000000000000000000000000000000000..e214db5e72febcc7936239783c249ce7ad2266c3
--- /dev/null
+++ b/android/tools/audit-desktop-surface.py
@@ -0,0 +1,44 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Inventory actual desktop source surfaces and installed Android plugins.
+
+Presence of a processing plugin is deliberately not classified as GUI parity.
+Run with --stage pointing to the runtime used for the APK; output is JSON.
+"""
+import argparse
+import json
+import re
+from pathlib import Path
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--stage', type=Path, required=True)
+args = parser.parse_args()
+repo = Path(__file__).resolve().parents[2]
+libraries = args.stage / 'jniLibs/arm64-v8a'
+if not libraries.is_dir():
+    parser.error('Expected the APK runtime stage with jniLibs/arm64-v8a')
+
+def targets(directory):
+    cmake = (repo / directory / 'CMakeLists.txt').read_text()
+    aliases = dict(re.findall(r'set_target_properties\(\s*(\w+)\s+PROPERTIES\s+OUTPUT_NAME\s+(\w+)\s*\)', cmake))
+    return list(dict.fromkeys((aliases.get(name, name), repo / directory / source) for name, source in
+                re.findall(r'^[ \t]*add_(?:iop|library)\(\s*(\w+)\s+(?:MODULE\s+)?"([^"\n]+\.(?:c|cc))"', cmake, re.M)))
+
+def surface(directory, prefix):
+    result = []
+    for name, path in targets(directory):
+        result.append({'name': name, 'source': str(path.relative_to(repo)),
+                       'android_plugin_installed': (libraries / (prefix + name + '.so')).is_file(),
+                       'complete_mobile_interaction_verified': False})
+    return result
+
+views = [{'name': name, 'source': str(path.relative_to(repo)),
+          'complete_mobile_view_ported': False} for name, path in targets('src/views')]
+document = {'reference': 'pinned desktop source, not a count of every desktop action',
+            'warning': 'Plugin presence only proves packaging. Widgets, pickers, gestures, dependencies and pixel output need separate checks.',
+            'views': views, 'panels': surface('src/libs', 'libdt_lib_'),
+            'processing': surface('src/iop', 'libdt_iop_'),
+            'formats': surface('src/imageio/format', 'libdt_format_')}
+document['counts'] = {key: len(document[key]) for key in ('views', 'panels', 'processing', 'formats')}
+document['installed_processing_plugins'] = sum(row['android_plugin_installed'] for row in document['processing'])
+print(json.dumps(document, indent=2) + '\n', end='')
diff --git a/android/tools/build-desktop-bridge.py b/android/tools/build-desktop-bridge.py
new file mode 100644
index 0000000000000000000000000000000000000000..55fabfc381d0d1e60178d6a345800915c72a3e4a
--- /dev/null
+++ b/android/tools/build-desktop-bridge.py
@@ -0,0 +1,55 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Extend a verified runtime with a source-built API-26 JNI sidecar bridge."""
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+
+sys.dont_write_bytecode = True
+repo = Path(__file__).resolve().parents[2]
+verifier = repo / 'mobile/dependencies/verify-android-runtime-stage.py'
+spec = importlib.util.spec_from_file_location('runtime_verifier', verifier)
+verify = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(verify)
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--stage', required=True, type=Path)
+parser.add_argument('--ndk', required=True, type=Path)
+parser.add_argument('--output', required=True, type=Path)
+args = parser.parse_args()
+original = args.stage.resolve(strict=True)
+output = args.output.resolve()
+if output.exists() or output.is_relative_to(original):
+    parser.error('Output must be a new directory outside the original stage')
+verify.verify(original, original / 'android-runtime-libraries.txt')
+output.parent.mkdir(parents=True, exist_ok=True)
+with tempfile.TemporaryDirectory(prefix='desktop-bridge-', dir=output.parent) as temporary:
+    stage = Path(temporary) / 'stage'
+    shutil.copytree(original, stage)
+    library = stage / 'jniLibs/arm64-v8a/libdarkroom_desktop.so'
+    if library.exists():
+        parser.error('Runtime already contains the desktop bridge')
+    toolchain = args.ndk / 'toolchains/llvm/prebuilt/linux-x86_64/bin'
+    source = repo / 'android/desktop-bridge/desktop_bridge.c'
+    subprocess.run([str(toolchain / 'aarch64-linux-android26-clang'), '-std=c11',
+                    '-shared', '-fPIC', '-O2', '-Wall', '-Wextra', '-Werror',
+                    '-Wl,--no-undefined', '-Wl,-z,max-page-size=16384',
+                    '-Wl,-soname,libdarkroom_desktop.so', str(source),
+                    '-L' + str(library.parent), '-ldarktable', '-o', str(library)], check=True)
+    elf = verify.stage.read_elf(library)
+    manifest = json.loads((stage / 'manifest.json').read_text())
+    manifest['libraries'][library.name] = dict(source=str(output / 'jniLibs/arm64-v8a' / library.name),
+        sourceCode=str(source), sourceCodeSha256=verify.stage.sha256(source),
+        sha256=verify.stage.sha256(library), soname=elf.soname,
+        needed=list(elf.needed), searchPaths=elf.search_paths)
+    manifest['configuredLibraries'] = sorted(manifest['configuredLibraries'] + [library.name])
+    (stage / 'android-runtime-libraries.txt').write_text('\n'.join(manifest['configuredLibraries']) + '\n')
+    (stage / 'manifest.json').write_text(json.dumps(manifest, indent=2, sort_keys=True) + '\n')
+    verify.verify(stage, stage / 'android-runtime-libraries.txt')
+    stage.rename(output)
+print(json.dumps({'stage': str(output), 'bridgeSha256': verify.stage.sha256(output / 'jniLibs/arm64-v8a/libdarkroom_desktop.so'),
+                  'originalRuntimeUnchanged': True}))
