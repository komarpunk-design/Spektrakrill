+@OptIn(ExperimentalFoundationApi::class)
+@Composable
+internal fun DesktopLighttable(photos: List<CatalogPhoto>, enabled: Boolean, canExport: Boolean,
+    onImport: () -> Unit, onOpen: (String) -> Unit, onExport: (List<String>) -> Unit, notice: String? = null) {
+    var query by rememberSaveable { mutableStateOf("") }
+    var stars by rememberSaveable { mutableIntStateOf(0) }
+    var rejected by rememberSaveable { mutableStateOf(false) }
+    var sort by rememberSaveable { mutableStateOf(CatalogSort.RECENT.name) }
+    var color by rememberSaveable { mutableIntStateOf(-1) }
+    var colorsOpen by remember { mutableStateOf(false) }
+    var selected by rememberSaveable { mutableStateOf(listOf<String>()) }
+    val filtered = remember(photos, query, stars, rejected, sort, color) {
+        CatalogQuery(query, stars, rejected, color.takeIf { it >= 0 }, CatalogSort.valueOf(sort)).select(photos)
+    }
+    val selection = selected.filter { id -> photos.any { it.project.id == id } }
+    Column(Modifier.fillMaxSize().padding(8.dp).testTag("desktop_contact_sheet")) {
+        Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            OutlinedTextField(query, { query = it }, singleLine = true, modifier = Modifier.weight(1f).testTag("lighttable_search"),
+                label = { Text(stringResource(R.string.catalog_search)) })
+            OutlinedButton(onImport, enabled = enabled) { Text(stringResource(R.string.catalog_import)) }
+        }
+        Row(Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            FilterChip(stars == 0 && !rejected, { stars = 0; rejected = false }, label = { Text(stringResource(R.string.module_presets_all)) })
+            for(value in 1..5) FilterChip(stars == value && !rejected, { stars = value; rejected = false }, label = { Text("$value★+") })
+            FilterChip(rejected, { rejected = !rejected }, label = { Text(stringResource(R.string.catalog_rejected)) })
+            Box {
+                val labels = listOf(R.string.catalog_red, R.string.catalog_yellow, R.string.catalog_green, R.string.catalog_blue, R.string.catalog_purple)
+                AssistChip({ colorsOpen = true }, label = { Text(stringResource(if(color < 0) R.string.catalog_marks else labels[color])) })
+                DropdownMenu(colorsOpen, { colorsOpen = false }) {
+                    DropdownMenuItem({ Text(stringResource(R.string.module_presets_all)) }, { color = -1; colorsOpen = false })
+                    labels.forEachIndexed { index, label -> DropdownMenuItem({ Text(stringResource(label)) }, { color = index; colorsOpen = false }) }
+                }
+            }
+            AssistChip({ sort = CatalogSort.entries[(CatalogSort.valueOf(sort).ordinal + 1) % CatalogSort.entries.size].name }, label = {
+                Text(stringResource(when(CatalogSort.valueOf(sort)) {
+                    CatalogSort.RECENT -> R.string.catalog_recent
+                    CatalogSort.NAME -> R.string.catalog_name
+                    CatalogSort.RATING -> R.string.catalog_rating
+                }))
+            })
+        }
+        notice?.let { Text(it, style = MaterialTheme.typography.bodySmall) }
+        Text(stringResource(R.string.desktop_contact_hint), style = MaterialTheme.typography.bodySmall)
+        if(filtered.isEmpty()) Box(Modifier.fillMaxWidth().weight(1f), contentAlignment = Alignment.Center) {
+            Text(stringResource(if(photos.isEmpty()) R.string.studio_welcome_hint else R.string.catalog_empty),
