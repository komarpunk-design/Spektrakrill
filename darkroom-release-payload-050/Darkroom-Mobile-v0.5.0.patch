+        TextButton({ onMode(false) }, enabled = ready, modifier = Modifier.weight(1f).testTag("desktop_darkroom")) {
+            Text(stringResource(R.string.desktop_darkroom), color = if(!lighttable) MaterialTheme.colorScheme.onSurface else
+                MaterialTheme.colorScheme.onSurfaceVariant, maxLines = 2)
+        }
+        IconButton(onHistory, enabled = ready && !lighttable, modifier = Modifier.testTag("desktop_history_toggle")) {
+            Icon(painterResource(R.drawable.workspace_ic_undo), stringResource(if(history) R.string.desktop_hide_history else R.string.desktop_show_history))
+        }
