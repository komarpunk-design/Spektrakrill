+/** Match the desktop's _l10n_ style segments without changing stored native names. */
+internal fun GettextCatalog.styleName(value: String): String {
+    val parts = value.split('|')
+    val start = if(parts.firstOrNull() == "_l10n_darktable") {
+        if(parts.getOrNull(1) in setOf("_l10n_examples", "_l10n_camera styles")) 2 else 1
+    } else 0
+    return parts.drop(start).ifEmpty { parts }.joinToString(" / ") { styleDescription(it) }
