+++ b/desktop-android/tools/start-desktop.sh
@@ -0,0 +1,31 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+set -eu
+mkdir -p "$XDG_RUNTIME_DIR" "$HOME/.config/darktable" "$HOME/.cache/darktable"
+chmod 700 "$XDG_RUNTIME_DIR"
+/usr/bin/dbus-uuidgen --ensure=/etc/machine-id
+# The HTTP display is a private filesystem socket. The separate native GTK
+# display uses an unpredictable XDG_RUNTIME_DIR supplied by the Android host.
+/usr/bin/broadwayd --unixsocket /tmp/h.sock :0 &
+display_pid=$!
+trap 'kill "$display_pid" 2>/dev/null || true' EXIT
+export APPDIR=/opt/darktable
+export GDK_BACKEND=broadway BROADWAY_DISPLAY=:0
+export GTK_DATA_PREFIX="$APPDIR" GTK_EXE_PREFIX="$APPDIR/usr"
+export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
+export XDG_DATA_DIRS="$APPDIR/usr/share:/usr/share"
+export GTK_PATH="$APPDIR/usr/lib/gtk-3.0"
+export GTK_IM_MODULE_FILE="$APPDIR/usr/lib/gtk-3.0/3.0.0/immodules.cache"
+export GDK_PIXBUF_MODULE_FILE="$APPDIR/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache"
+export GIO_EXTRA_MODULES="$APPDIR/usr/lib/gio/modules"
+export LD_LIBRARY_PATH="$APPDIR/usr/lib:$APPDIR/usr/lib/aarch64-linux-gnu:$APPDIR/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders"
+for directory in "$APPDIR"/usr/lib/libgphoto2/*; do if [ -d "$directory" ]; then export CAMLIBS="$directory"; break; fi; done
+for directory in "$APPDIR"/usr/lib/libgphoto2_port/*; do if [ -d "$directory" ]; then export IOLIBS="$directory"; break; fi; done
+# Network/camera configuration remains in the original desktop preferences.
+# This is an output-directory adaptation, not a processing preset.
+/usr/bin/env -u LD_LIBRARY_PATH /usr/bin/dbus-run-session -- /usr/bin/env "LD_LIBRARY_PATH=$LD_LIBRARY_PATH" "$APPDIR/usr/bin/darktable" \
+    --datadir "$APPDIR/usr/share/darktable" \
+    --moduledir "$APPDIR/usr/lib/aarch64-linux-gnu/darktable" \
+    --configdir "$HOME/.config/darktable" --cachedir "$HOME/.cache/darktable" \
+    --library "$HOME/.config/darktable/library.db" \
+    --conf 'plugins/imageio/storage/disk/file_directory=/exports/$(FILE_NAME)' "$@"
diff --git a/desktop-android/tools/verify-apk.py b/desktop-android/tools/verify-apk.py
new file mode 100644
index 0000000..2c595d4
--- /dev/null
+++ b/desktop-android/tools/verify-apk.py
@@ -0,0 +1,42 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Check the actual packaged runtime contract, including AAPT transformations."""
+import argparse, hashlib, json, struct, zipfile
+from pathlib import Path
+
+def digest(stream):
+    return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('apk',type=Path)
+    parser.add_argument('--stage',type=Path,required=True)
+    parser.add_argument('--report',type=Path,required=True)
+    args=parser.parse_args()
+    with zipfile.ZipFile(args.apk) as archive:
+        names=archive.namelist()
+        if len(names)!=len(set(names)):raise ValueError('Duplicate APK entries')
+        if archive.testzip() is not None:raise ValueError('APK CRC failure')
+        manifest=json.loads(archive.read('assets/desktop-manifest.json'))
+        if manifest!=json.loads((args.stage/'assets/desktop-manifest.json').read_text()):
+            raise ValueError('Packaged manifest differs from the verified stage')
+        payload=archive.getinfo('assets/desktop-runtime.payload')
+        if payload.compress_type!=zipfile.ZIP_STORED or payload.file_size!=manifest['compressedBytes']:
+            raise ValueError('AAPT transformed the original runtime stream')
+        with archive.open(payload) as stream:
+            if digest(stream)!=manifest['sha256']:raise ValueError('Runtime SHA-256 mismatch')
+        with archive.open(payload) as stream:
+            if stream.read(2)!=b'\x1f\x8b':raise ValueError('Runtime is not a GZIP stream')
+        executable=archive.read('lib/arm64-v8a/libdesktop_proot.so')
+        if executable!=(args.stage/'jniLibs/arm64-v8a/libdesktop_proot.so').read_bytes():
+            raise ValueError('Android PRoot executable was transformed')
+        if executable[:5]!=b'\x7fELF\x02' or struct.unpack_from('<H',executable,18)[0]!=183:
+            raise ValueError('Expected the original ARM64 Android executable')
+    with args.apk.open('rb') as stream:sha=digest(stream)
+    result={'apk':args.apk.name,'bytes':args.apk.stat().st_size,'sha256':sha,
+        'zip_crc_verified':True,'payload_sha256_verified':True,'payload_stored_without_aapt_transformation':True,
+        'original_android_proot_bytes_preserved':True,'runtime':manifest}
+    args.report.write_text(json.dumps(result,indent=2)+'\n')
+    print(json.dumps({k:v for k,v in result.items() if k!='runtime'},indent=2))
+
+if __name__=='__main__':main()
