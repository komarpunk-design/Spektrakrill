+    private static void collect(File dir,List<File> files){for(File file:dir.listFiles()==null?new File[0]:dir.listFiles())if(!java.nio.file.Files.isSymbolicLink(file.toPath())){if(file.isDirectory())collect(file,files);else files.add(file);}}
+    @Override protected void onActivityResult(int request,int result,Intent data){super.onActivityResult(request,result,data);if(result!=RESULT_OK || data==null)return;
+        ArrayList<Uri> uris=new ArrayList<>();if(data.getClipData()!=null)for(int i=0;i<data.getClipData().getItemCount();i++)uris.add(data.getClipData().getItemAt(i).getUri());else if(data.getData()!=null)uris.add(data.getData());
