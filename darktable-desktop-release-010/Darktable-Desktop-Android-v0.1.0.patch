@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package design.komarpunk.darktable.desktop;
+
+import android.content.Context;
+import org.json.JSONObject;
+import java.io.*;
+import java.security.*;
+import java.util.zip.GZIPInputStream;
+
+final class RuntimeInstaller {
+    interface Status { void show(String message); }
+    static File install(Context context, Status status) throws Exception {
+        JSONObject manifest;
+        try(InputStream in=context.getAssets().open("desktop-manifest.json")) {
+            ByteArrayOutputStream data=new ByteArrayOutputStream(); byte[] b=new byte[8192];int n;
+            while((n=in.read(b))!=-1) { if(data.size()+n>65536)throw new IOException("Runtime manifest too large");data.write(b,0,n); }
+            manifest=new JSONObject(data.toString("UTF-8"));
+        }
+        String expected=manifest.getString("sha256");
+        File installed=new File(context.getFilesDir(),"desktop-runtime"), marker=new File(installed,".verified");
+        if(marker.isFile()) {
+            try(InputStream in=new FileInputStream(marker)) {
+                byte[] b=new byte[128];int n=in.read(b);
+                if(n>0 && expected.equals(new String(b,0,n,java.nio.charset.StandardCharsets.UTF_8))) return installed;
+            }
+        }
+        if(installed.exists()) throw new IOException("An incomplete runtime exists; its files were preserved. Clear this app's storage to reinstall, after saving any work.");
+        File stage=new File(context.getFilesDir(),".desktop-install");
+        if(stage.exists()) delete(stage);
+        if(!stage.mkdirs())throw new IOException("Cannot create private runtime");
+        MessageDigest digest=MessageDigest.getInstance("SHA-256");
+        long budget=manifest.getLong("uncompressedBytes"), free=stage.getUsableSpace();
+        if(free<budget+128L*1024*1024)throw new IOException("Not enough free space for original desktop libraries: "+(budget/1024/1024)+" MiB required");
+        try {
+            try(InputStream raw=context.getAssets().open("desktop-runtime.payload");
+                DigestInputStream checked=new DigestInputStream(raw,digest);
+                GZIPInputStream tar=new GZIPInputStream(checked,65536)) {
+                final long[] last={-1};
+                TarExtractor.extract(tar,stage.toPath(),budget,bytes->{
+                    long percent=bytes*100/Math.max(1,budget);
+                    if(percent!=last[0]) {last[0]=percent;status.show("Распаковка оригинального darktable: "+percent+"%");}
+                });
+                byte[] drain=new byte[65536];while(tar.read(drain)!=-1) { }
+            }
+            StringBuilder actual=new StringBuilder();for(byte b:digest.digest())actual.append(String.format(java.util.Locale.ROOT,"%02x",b&255));
+            if(!expected.contentEquals(actual))throw new IOException("The original runtime failed its SHA-256 check");
+            try(FileOutputStream out=new FileOutputStream(new File(stage,".verified"))) {out.write(expected.getBytes(java.nio.charset.StandardCharsets.UTF_8));out.getFD().sync();}
+            if(!stage.renameTo(installed))throw new IOException("Unable to commit the verified runtime");
+            return installed;
+        } catch(Exception error) {delete(stage);throw error;}
+    }
+    private static void delete(File path) {
+        if(!java.nio.file.Files.isSymbolicLink(path.toPath())) for(File child:path.listFiles()==null?new File[0]:path.listFiles())delete(child);
+        path.delete();
+    }
+}
diff --git a/desktop-android/app/src/main/java/design/komarpunk/darktable/desktop/TarExtractor.java b/desktop-android/app/src/main/java/design/komarpunk/darktable/desktop/TarExtractor.java
new file mode 100644
index 0000000..93bea13
--- /dev/null
+++ b/desktop-android/app/src/main/java/design/komarpunk/darktable/desktop/TarExtractor.java
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package design.komarpunk.darktable.desktop;
+
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.*;
+import java.nio.file.attribute.PosixFilePermission;
+import java.util.*;
+
+/** A bounded USTAR reader for the pinned runtime, never for photo imports. */
+final class TarExtractor {
+    interface Progress { void bytes(long amount); }
+    static void extract(InputStream input, Path root, long budget, Progress progress) throws IOException {
+        Files.createDirectories(root);
+        byte[] header = new byte[512], buffer = new byte[65536];
+        long total = 0;
+        while (true) {
+            if(Thread.currentThread().isInterrupted())throw new InterruptedIOException("Runtime installation canceled");
+            readFully(input, header, 512);
+            boolean zero = true;
+            for (byte b : header) if (b != 0) { zero = false; break; }
+            if (zero) break;
+            long checksum = octal(header, 148, 8), sum = 0;
+            for (int i=0;i<512;i++) sum += i>=148 && i<156 ? 32 : header[i]&255;
+            if (checksum != sum) throw new IOException("Invalid runtime archive checksum");
+            String name = text(header,0,100), prefix = text(header,345,155);
+            if (!prefix.isEmpty()) name = prefix + "/" + name;
+            if (name.startsWith("/") || name.indexOf('\\')>=0) throw new IOException("Invalid runtime path");
+            Path path = root.resolve(name).normalize();
+            if (!path.startsWith(root) || path.equals(root)) throw new IOException("Runtime path escapes its directory");
+            for (Path p=path.getParent(); p!=null && p.startsWith(root); p=p.getParent())
+                if (Files.isSymbolicLink(p)) throw new IOException("Runtime entry follows a symlink");
+            long size = octal(header,124,12); int kind = header[156];
+            if (size < 0 || size > budget-total) throw new IOException("Runtime archive exceeds its budget");
+            total += size;
+            Files.createDirectories(path.getParent());
+            if (kind=='5') {
+                if(size!=0) throw new IOException("Invalid runtime directory");
+                Files.createDirectories(path);
+            } else if (kind=='2') {
+                if(size!=0) throw new IOException("Invalid runtime symlink");
+                Files.createSymbolicLink(path, Paths.get(text(header,157,100)));
+            } else if (kind==0 || kind=='0') {
+                try (OutputStream out=Files.newOutputStream(path,StandardOpenOption.CREATE_NEW)) {
+                    long remaining=size;
+                    while(remaining>0) {
+                        if(Thread.currentThread().isInterrupted())throw new InterruptedIOException("Runtime installation canceled");
+                        int n=input.read(buffer,0,(int)Math.min(buffer.length,remaining));
+                        if(n<0) throw new EOFException("Truncated runtime archive");
+                        out.write(buffer,0,n);remaining-=n;
+                    }
+                }
+                int mode=(int)octal(header,100,8)&0777;
+                Set<PosixFilePermission> permissions=EnumSet.noneOf(PosixFilePermission.class);
+                PosixFilePermission[] bits={PosixFilePermission.OTHERS_EXECUTE,PosixFilePermission.OTHERS_WRITE,PosixFilePermission.OTHERS_READ,
+                    PosixFilePermission.GROUP_EXECUTE,PosixFilePermission.GROUP_WRITE,PosixFilePermission.GROUP_READ,
+                    PosixFilePermission.OWNER_EXECUTE,PosixFilePermission.OWNER_WRITE,PosixFilePermission.OWNER_READ};
+                for(int i=0;i<9;i++) if((mode&(1<<i))!=0) permissions.add(bits[i]);
+                Files.setPosixFilePermissions(path,permissions);
+            } else throw new IOException("Unsupported runtime archive entry");
+            int padding=(int)((512-size%512)%512);
+            if(padding>0) readFully(input,buffer,padding);
+            progress.bytes(total);
+        }
+    }
+    static String text(byte[] b,int offset,int size) {
+        int end=offset;while(end<offset+size && b[end]!=0)end++;
+        return new String(b,offset,end-offset,StandardCharsets.UTF_8);
+    }
+    static long octal(byte[] b,int offset,int size) throws IOException {
+        String s=text(b,offset,size).trim();
+        try { return s.isEmpty()?0:Long.parseLong(s,8); } catch(NumberFormatException e) { throw new IOException("Invalid runtime archive number",e); }
+    }
+    static void readFully(InputStream in,byte[] b,int size) throws IOException {
+        int read=0;while(read<size) { int n=in.read(b,read,size-read);if(n<0)throw new EOFException("Truncated runtime archive");read+=n; }
