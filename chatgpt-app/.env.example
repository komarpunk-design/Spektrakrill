# Set the public HTTPS origin only after selecting a host and configuring access control.
# SPEKTRA_PUBLIC_URL=https://photos.example.com
SPEKTRA_PUBLIC_URL=http://127.0.0.1:8765
SPEKTRA_BIND=127.0.0.1
PORT=8765
SPEKTRA_LOCAL_TEST=0
# Compose production deployment additionally requires:
# SPEKTRA_DOMAIN=photos.example.com
# Comma-separated trusted ChatGPT download hosts, not arbitrary user URLs.
SPEKTRA_UPLOAD_HOSTS=files.oaiusercontent.com,files.openai.com,*.oaiusercontent.com
# Public deployments require an existing OAuth/OIDC issuer configured for PKCE and ChatGPT.
# SPEKTRA_OAUTH_ISSUER=https://identity.example.com
# SPEKTRA_OAUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# Token audience must exactly match SPEKTRA_PUBLIC_URL + /mcp; required scope: photos:develop.
# For a personal instance, restrict it to your verified provider subject ID:
# SPEKTRA_ALLOWED_SUBJECTS=your-verified-subject-id
